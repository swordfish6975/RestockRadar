{
  "Monitor": {
    // Which console(s) to hunt for: "PS5Disc", "PS5Digital", "PS5Pro", "PS5" (disc or digital), "All",
    // or a combination like "PS5Disc, PS5Pro". Can also be set with --product.
    "Product": "PS5Pro",
    "IntervalSeconds": 120,
    "JitterSeconds": 30,
    "Headless": false,
    "ChromePath": null,
    "AlertAfterFailures": 5,
    "BeepOnAlert": true
  },

  // Fill these in here, or (better, it's git-ignored) in appsettings.local.json.
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
    "ChatId": "YOUR_TELEGRAM_CHAT_ID"
  },

  "Amazon": {
    "AutoBuy": false,
    "DryRun": true,
    "MaxPrice": 900,
    "RequireSoldByAmazon": true,
    "BaseUrl": "https://www.amazon.com.au",
    // Optional - only used if the saved session expires. Running --login once is the better option.
    "Email": "YOUR_AMAZON_EMAIL",
    "Password": "YOUR_AMAZON_PASSWORD",
    "TotpSecret": "YOUR_AMAZON_2FA_SECRET"
  },

  // Product = which console the page sells: PS5Disc, PS5Digital or PS5Pro (PS5 if it could be either edition).
  // Only sites matching Monitor:Product are checked.
  // Selector = the bit of the page to watch (the buy box). InStockText / OutOfStockText = keywords that decide stock.
  // Leave both keyword lists empty to get an alert on ANY change in the watched text.
  // Run "--probe <name>" to see what the app reads on a page and where the stock words sit.
  "Sites": [
    {
      // The original (pre-Slim) disc PS5 listing - Amazon says it may not come back.
      "Name": "amazon-disc",
      "Product": "PS5Disc",
      "Url": "https://www.amazon.com.au/dp/B08HHV8945",
      "Selector": "#desktop_buybox, #buybox, #outOfStock",
      "InStockText": [ "Add to Cart", "Buy Now" ],
      "OutOfStockText": [ "Currently unavailable", "Temporarily out of stock" ],
      "AutoBuy": true,
      "MaxPrice": 900
    },
    {
      "Name": "amazon-pro",
      "Product": "PS5Pro",
      "Url": "https://www.amazon.com.au/dp/B0DH4LCQV6",
      "Selector": "#desktop_buybox, #buybox, #outOfStock",
      "InStockText": [ "Add to Cart", "Buy Now" ],
      "OutOfStockText": [ "Currently unavailable", "Temporarily out of stock" ],
      "AutoBuy": true,
      "MaxPrice": 1400
    },
    {
      "Name": "jbhifi-disc",
      "Product": "PS5Disc",
      "Url": "https://www.jbhifi.com.au/products/ps5-playstation-5-slim-console",
      "Selector": "#pdp-right-panel",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "Out of stock", "currently unavailable" ]
    },
    {
      "Name": "jbhifi-digital",
      "Product": "PS5Digital",
      "Url": "https://www.jbhifi.com.au/products/ps5-playstation-5-slim-digital-console",
      "Selector": "#pdp-right-panel",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "Out of stock", "currently unavailable" ]
    },
    {
      "Name": "jbhifi-pro",
      "Product": "PS5Pro",
      "Url": "https://www.jbhifi.com.au/products/ps5-playstation-5-pro-console",
      "Selector": "#pdp-right-panel",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "Out of stock", "currently unavailable" ]
    },
    {
      "Name": "goodguys-digital",
      "Product": "PS5Digital",
      "Url": "https://www.thegoodguys.com.au/playstation-5-console-digital-edition-slim-171826",
      "Selector": "[class*='_rightColContainer_']",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "Out of stock", "Sold out", "Currently unavailable", "Notify me" ]
    },
    {
      "Name": "target-pro",
      "Product": "PS5Pro",
      "Url": "https://www.target.com.au/p/playstation-5-pro-console/71080888",
      "Selector": "[data-testid='controls-details-panel']",
      "InStockText": [ "Add To Basket" ],
      "OutOfStockText": [ "Out of stock", "Sold out", "unavailable" ]
    },
    {
      "Name": "sony-pro",
      "Product": "PS5Pro",
      "Url": "https://store.sony.com.au/playstation-5-console/PLAYSTATION5PRO.html",
      "Selector": ".product-actions",
      "InStockText": [ "Add to Cart" ],
      "OutOfStockText": [ "currently unavailable" ]
    },
    {
      "Name": "harveynorman-pro",
      "Product": "PS5Pro",
      "Url": "https://www.harveynorman.com.au/ps5-playstation-5-pro-console.html",
      "Selector": "#gel-slab-pdp",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "out of stock", "unavailable", "Sold out" ]
    },
    {
      // EB Games only sells the new PS5 Pro as this bundle (console + 2nd DualSense + 2yr EB Protect).
      "Name": "ebgames-pro",
      "Product": "PS5Pro",
      "Url": "https://www.ebgames.com.au/product/ps5/814148-ps5-pro-console-2nd-dualsense-2-years-eb-protect-bundle",
      "Selector": ".product-actions",
      "InStockText": [ "Add to cart", "Pre-order" ],
      "OutOfStockText": [ "Out of Stock", "unavailable", "Sold out" ]
    },
    {
      "Name": "kmart-pro",
      "Product": "PS5Pro",
      "Enabled": false, // Kmart answers automated browsers with HTTP 429 - try it with Headless off, or leave disabled
      "Url": "https://www.kmart.com.au/product/playstation-5-pro-console-110012215",
      "InStockText": [ "Add to cart" ],
      "OutOfStockText": [ "Out of stock", "unavailable" ]
    }
  ]
}
